<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Circus.Users.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Circus.Users.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Circus Users">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Сплошной фон под содержимым. Показывается, когда материал подложки выключен:
             ThemeResource сам пересчитывается при смене темы, поэтому фон всегда совпадает
             с текущей темой окна. -->
        <Border x:Name="SolidBackground"
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                Visibility="Collapsed" />

        <!-- Заголовок остаётся прозрачным, чтобы сквозь него был виден материал подложки.
             Системные кнопки окна рисует Windows. -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="40">
            <StackPanel Orientation="Horizontal"
                        Spacing="12"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">
                <Image Source="Assets/Square44x44Logo.scale-200.png"
                       Width="16"
                       Height="16" />
                <TextBlock x:Name="AppTitleText"
                           Text="Circus Users"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Отступ справа освобождает место под кнопки свернуть/развернуть/закрыть. -->
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,0,150,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock x:Name="CurrentUserText"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
                <Border x:Name="RoleBadge"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="10"
                        Padding="8,2"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="RoleText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsTitleBarAutoPaddingEnabled="False"
                        SelectionChanged="OnNavigationSelectionChanged">

            <NavigationView.KeyboardAccelerators>
                <KeyboardAccelerator Modifiers="Control" Key="Number1" Invoked="OnNavigateAccelerator" />
                <KeyboardAccelerator Modifiers="Control" Key="Number2" Invoked="OnNavigateAccelerator" />
                <KeyboardAccelerator Modifiers="Control" Key="Number3" Invoked="OnNavigateAccelerator" />
                <KeyboardAccelerator Modifiers="Control" Key="Number4" Invoked="OnNavigateAccelerator" />
                <KeyboardAccelerator Modifiers="Control" Key="Number5" Invoked="OnNavigateAccelerator" />
            </NavigationView.KeyboardAccelerators>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="AddUserItem" Content="Добавить пользователя" Tag="add-user">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="AddFriend" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AddressBookItem" Content="Адресная книга" Tag="address-book">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="ContactInfo" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DepartmentsItem" Content="Подразделения" Tag="departments">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Folder" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="JournalItem" Content="Журнал операций" Tag="journal">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="List" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SettingsItem" Content="Настройки" Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Область страниц непрозрачна: материал подложки виден только
                 в заголовке и в панели навигации, а текст страниц читается на ровном фоне. -->
            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="8,0,0,0">
                <Frame x:Name="ContentFrame" />
            </Border>
        </NavigationView>

        <!-- Полоса изменения ширины панели: лежит поверх NavigationView у правого края панели. -->
        <controls:PaneResizeGrip x:Name="PaneGrip"
                                 Grid.Row="1"
                                 Width="8"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Stretch"
                                 Background="Transparent"
                                 Visibility="Collapsed"
                                 ManipulationMode="TranslateX"
                                 ManipulationDelta="OnPaneGripManipulationDelta"
                                 ManipulationCompleted="OnPaneGripManipulationCompleted"
                                 DoubleTapped="OnPaneGripDoubleTapped"
                                 ToolTipService.ToolTip="Потяните, чтобы изменить ширину. Двойной щелчок — по ширине подписей." />
    </Grid>
</Window>
