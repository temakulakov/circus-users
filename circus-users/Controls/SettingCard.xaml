<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Circus.Users.App.Controls.SettingCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource ControlCornerRadius}"
            Padding="16,14">
        <StackPanel>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <!-- Фиксированная колонка значка: карточки без значка не должны съезжать. -->
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0"
                          Glyph="{x:Bind Glyph, Mode=OneWay}"
                          FontSize="17"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                          Visibility="{x:Bind HasGlyph, Mode=OneWay}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Header, Mode=OneWay}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind HasDescription, Mode=OneWay}" />
                </StackPanel>

                <ContentPresenter Grid.Column="2"
                                  Content="{x:Bind ActionContent, Mode=OneWay}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right" />
            </Grid>

            <!-- Вложенный подпункт: отделяется линией и сдвигается под текст основной строки. -->
            <StackPanel Visibility="{x:Bind SubContentVisibility, Mode=OneWay}">
                <Border Height="1"
                        Margin="0,14,0,12"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                <ContentPresenter Content="{x:Bind SubContent, Mode=OneWay}"
                                  Margin="36,0,0,0"
                                  HorizontalContentAlignment="Stretch" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
