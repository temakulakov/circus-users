<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Circus.Users.App.Views.DepartmentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Circus.Users.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="36,20,36,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Настройка подразделений"
                   Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <Button Command="{x:Bind ViewModel.RefreshCommand}"
                    ToolTipService.ToolTip="Обновить справочник"
                    AutomationProperties.Name="Обновить подразделения">
                <FontIcon Glyph="&#xE72C;" FontSize="15" />
            </Button>
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260" MaxWidth="420" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Padding="8">
                <TreeView ItemsSource="{x:Bind ViewModel.Tree}"
                          SelectionMode="Single"
                          SelectedItem="{x:Bind ViewModel.SelectedNode, Mode=TwoWay}"
                          AutomationProperties.Name="Дерево подразделений">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DepartmentNode">
                            <TreeViewItem ItemsSource="{x:Bind Children}"
                                          IsExpanded="False"
                                          AutomationProperties.Name="{x:Bind Name}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                                    <Border Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                            CornerRadius="4"
                                            Padding="6,1"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind MarkerVisibility, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind Marker, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Padding="24">
                <Grid>
                    <TextBlock Text="Выберите подразделение в дереве"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{x:Bind FormVisibility, Mode=OneWay}">
                        <StackPanel Spacing="16">
                            <TextBlock Text="{x:Bind ViewModel.SelectedNode.Name, Mode=OneWay}"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       TextWrapping="Wrap" />

                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Padding="16,12">
                                <StackPanel Spacing="8">
                                    <ToggleSwitch Header="Это подразделение"
                                                  OnContent="Да"
                                                  OffContent="Нет, каталог служебный"
                                                  IsOn="{x:Bind ViewModel.IsDepartment, Mode=OneWay}"
                                                  Toggled="OnDepartmentToggled"
                                                  AutomationProperties.Name="Считать каталог подразделением" />
                                    <TextBlock Text="{x:Bind ViewModel.DepartmentSwitchNotice, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- ContentControl ради IsEnabled: у Panel этого свойства нет,
                                 а форма шаблона должна гаснуть целиком. -->
                            <ContentControl IsEnabled="{x:Bind ViewModel.IsTemplateEnabled, Mode=OneWay}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="16">
                                <InfoBar IsOpen="True"
                                         IsClosable="False"
                                         Severity="Informational"
                                         Message="{x:Bind ViewModel.WriteTargetNotice, Mode=OneWay}" />

                                <TextBlock Text="Значения нового сотрудника"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />

                                <Grid ColumnSpacing="16" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBox Grid.Row="0" Grid.Column="0"
                                             Header="Организация"
                                             Text="{x:Bind ViewModel.Company, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             Header="Городской телефон"
                                             Text="{x:Bind ViewModel.TelephoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBox Grid.Row="1" Grid.Column="0"
                                             Header="Город"
                                             Text="{x:Bind ViewModel.City, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                             Header="Адрес"
                                             Text="{x:Bind ViewModel.StreetAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBox Grid.Row="2" Grid.Column="0"
                                             Header="Кабинет"
                                             Text="{x:Bind ViewModel.Office, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <AutoSuggestBox x:Name="ManagerBox"
                                                    Grid.Row="2" Grid.Column="1"
                                                    Header="Руководитель"
                                                    QueryIcon="Find"
                                                    PlaceholderText="Начните вводить ФИО"
                                                    Text="{x:Bind ViewModel.ManagerQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    ItemsSource="{x:Bind ViewModel.ManagerSuggestions}"
                                                    TextChanged="OnManagerTextChanged"
                                                    SuggestionChosen="OnManagerChosen"
                                                    AutomationProperties.Name="Руководитель подразделения">
                                        <AutoSuggestBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ManagerOption">
                                                <StackPanel Padding="0,4" AutomationProperties.Name="{x:Bind DisplayName}">
                                                    <TextBlock Text="{x:Bind DisplayName}" />
                                                    <TextBlock Text="{x:Bind Note}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </AutoSuggestBox.ItemTemplate>
                                    </AutoSuggestBox>
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="8">
                                        <TextBlock Text="Группы Active Directory"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />

                                        <AutoSuggestBox QueryIcon="Find"
                                                        PlaceholderText="Поиск группы"
                                                        AutomationProperties.Name="Поиск группы каталога"
                                                        Text="{x:Bind ViewModel.GroupFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                                Height="220">
                                            <ListView ItemsSource="{x:Bind ViewModel.Groups}"
                                                      SelectionMode="None"
                                                      AutomationProperties.Name="Группы каталога">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:SelectableOption">
                                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                                  MinWidth="0"
                                                                  AutomationProperties.Name="{x:Bind Name}">
                                                            <StackPanel>
                                                                <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                                                <TextBlock Text="{x:Bind Note}"
                                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                           Visibility="{x:Bind NoteVisibility}" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock Text="Группы рассылки Yandex"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />

                                        <AutoSuggestBox QueryIcon="Find"
                                                        PlaceholderText="Поиск рассылки"
                                                        AutomationProperties.Name="Поиск группы рассылки"
                                                        Text="{x:Bind ViewModel.MailGroupFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                                Height="220">
                                            <Grid>
                                                <ListView ItemsSource="{x:Bind ViewModel.MailGroups}"
                                                          SelectionMode="None"
                                                          AutomationProperties.Name="Группы рассылки">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:SelectableOption">
                                                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                                      MinWidth="0"
                                                                      AutomationProperties.Name="{x:Bind Name}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{x:Bind Note}"
                                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                               Visibility="{x:Bind NoteVisibility}" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>

                                                <TextBlock Text="{x:Bind ViewModel.MailGroupsStatus, Mode=OneWay}"
                                                           Margin="12"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Content="Сохранить шаблон"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="OnSaveClick"
                                            AutomationProperties.Name="Сохранить шаблон" />
                                    <Button Content="Очистить"
                                            Command="{x:Bind ViewModel.ClearTemplateCommand}" />
                                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                                  Width="20"
                                                  Height="20"
                                                  VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            </ContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
