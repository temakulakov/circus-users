<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Circus.Users.App.Views.AddressBookPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Circus.Users.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <CollectionViewSource x:Key="GroupedRows" IsSourceGrouped="True" />

        <!-- Содержимое строки растягивается на всю ширину колонок. -->
        <Style x:Key="TableRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
    </Page.Resources>

    <Grid Margin="36,20,36,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Адресная книга"
                   Style="{StaticResource TitleTextBlockStyle}" />

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox Grid.Column="0"
                            QueryIcon="Find"
                            PlaceholderText="Поиск по имени, должности, телефону"
                            AutomationProperties.Name="Поиск сотрудника"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="1"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    ToolTipService.ToolTip="Обновить справочник"
                    AutomationProperties.Name="Обновить справочник">
                <FontIcon Glyph="&#xE72C;" FontSize="15" />
            </Button>

            <Button Grid.Column="2"
                    Click="OnConfigureFieldsClick"
                    ToolTipService.ToolTip="Настроить колонки"
                    AutomationProperties.Name="Настроить колонки">
                <FontIcon Glyph="&#xE71C;" FontSize="15" />
            </Button>

            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <ProgressRing IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}"
                              Width="16"
                              Height="16" />
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
            <Grid>
                <!-- Шапка и строки прокручиваются вбок как одно целое, поэтому лежат
                     в общем горизонтальном ScrollViewer одинаковой ширины. -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Auto"
                              VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled">
                    <Grid Width="{x:Bind ViewModel.TableWidth, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Padding="12,10"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <!-- Пустое место под колонку с карандашом. -->
                                <Border Width="{x:Bind ViewModel.ActionsWidth, Mode=OneWay}" />

                                <ItemsControl ItemsSource="{x:Bind ViewModel.Columns}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TableColumn">
                                            <TextBlock Text="{x:Bind Title}"
                                                       Width="{x:Bind Width}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,12,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <ListView x:Name="EmployeeTable"
                                  Grid.Row="1"
                                  ItemsSource="{Binding Source={StaticResource GroupedRows}}"
                                  SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}"
                                  ItemContainerStyle="{StaticResource TableRowStyle}"
                                  AutomationProperties.Name="Таблица сотрудников">
                            <ListView.GroupStyle>
                                <GroupStyle HidesIfEmpty="True">
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <!-- Непрозрачная подложка: заголовок группы
                                                 закреплён сверху, и без неё строки просвечивают сквозь него. -->
                                            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                    Padding="0,10,0,6">
                                                <TextBlock Text="{Binding Key}"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:EmployeeRow">
                                    <Grid Tag="{x:Bind}"
                                          Background="Transparent"
                                          PointerEntered="OnRowPointerEntered"
                                          PointerExited="OnRowPointerExited"
                                          RightTapped="OnRowRightTapped"
                                          AutomationProperties.Name="{x:Bind Employee.DisplayName}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Карандаш проявляется при наведении на строку. -->
                                        <Button x:Name="EditButton"
                                                Grid.Column="0"
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                Margin="0,0,12,0"
                                                Opacity="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Tag="{x:Bind}"
                                                Click="OnEditClick"
                                                Visibility="{x:Bind ActionsVisibility}"
                                                ToolTipService.ToolTip="Изменить данные сотрудника"
                                                AutomationProperties.Name="Изменить данные сотрудника">
                                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                        </Button>

                                        <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Cells}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:TableCell">
                                                    <TextBlock Text="{x:Bind Value}"
                                                               Width="{x:Bind Column.Width}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ToolTip="{x:Bind Value}"
                                                               Margin="0,0,12,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </ScrollViewer>

                <TextBlock Text="Никого не нашлось"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
            </Grid>
        </Border>

        <!-- Настройка колонок -->
        <ContentDialog x:Name="FieldsDialog"
                       Title="Колонки таблицы"
                       PrimaryButtonText="Применить"
                       SecondaryButtonText="Сбросить"
                       CloseButtonText="Отмена"
                       DefaultButton="Primary">
            <StackPanel Spacing="12" Width="380">
                <TextBlock Text="Отметьте нужные колонки и перетащите их в удобном порядке."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
                <ListView ItemsSource="{x:Bind ViewModel.FieldOptions}"
                          SelectionMode="None"
                          CanReorderItems="True"
                          AllowDrop="True"
                          Height="300">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FieldOption">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          Content="{x:Bind Title}"
                                          IsChecked="{x:Bind IsVisible, Mode=TwoWay}" />
                                <FontIcon Grid.Column="1"
                                          Glyph="&#xE700;"
                                          FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <CheckBox x:Name="ApplyForEveryoneCheck"
                          Content="Применить для всех сотрудников"
                          AutomationProperties.AutomationId="ApplyForEveryoneCheck"
                          Visibility="{x:Bind ViewModel.AdminVisibility}" />
                <TextBlock Text="Общий вид получат только те, кто не настраивал колонки под себя."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.AdminVisibility}" />
            </StackPanel>
        </ContentDialog>

        <!-- Правка данных сотрудника -->
        <ContentDialog x:Name="EditDialog"
                       PrimaryButtonText="Сохранить"
                       CloseButtonText="Отмена"
                       DefaultButton="Primary">
            <StackPanel Spacing="12" Width="380">
                <InfoBar IsOpen="True"
                         IsClosable="False"
                         Severity="Warning"
                         Message="{x:Bind ViewModel.WriteTargetNotice, Mode=OneWay}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360">
                <ItemsControl ItemsSource="{x:Bind ViewModel.EditFields}" Width="380">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EditableField">
                            <TextBox Header="{x:Bind Title}"
                                     Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,12" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
