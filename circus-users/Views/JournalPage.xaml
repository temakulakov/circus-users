<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Circus.Users.App.Views.JournalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Circus.Users.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
        <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnSearchAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid Margin="36,20,36,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Журнал операций"
                   Style="{StaticResource TitleTextBlockStyle}" />

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox x:Name="SearchBox"
                            Grid.Column="0"
                            QueryIcon="Find"
                            PlaceholderText="Поиск по журналу"
                            AutomationProperties.Name="Поиск по журналу"
                            ToolTipService.ToolTip="Поиск по журналу (Ctrl+F)"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="1"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    ToolTipService.ToolTip="Перечитать журнал (F5)"
                    AutomationProperties.Name="Перечитать журнал">
                <FontIcon Glyph="&#xE72C;" FontSize="15" />
            </Button>

            <TextBlock Grid.Column="2"
                       Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTipService.ToolTip="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        </Grid>

        <InfoBar Grid.Row="2"
                 IsOpen="True"
                 IsClosable="False"
                 Severity="Warning"
                 Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                 Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}" />

        <Border Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
            <Grid>
                <ListView ItemsSource="{x:Bind ViewModel.Rows}"
                          SelectionMode="Single"
                          AutomationProperties.Name="Записи журнала">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:JournalRow">
                            <Grid ColumnSpacing="16"
                                  Padding="0,8"
                                  AutomationProperties.Name="{x:Bind Summary}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind When}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Actor}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Top" />
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind Action}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Top" />
                                <StackPanel Grid.Column="3" Spacing="2">
                                    <TextBlock Text="{x:Bind Target}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Details}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{x:Bind DetailsVisibility}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                    <FontIcon Glyph="&#xE9D9;"
                              FontSize="28"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              Width="28"
                              Height="28"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Page>
