root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{xml,xaml,appxmanifest,csproj,props,targets,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Директивы using
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:suggestion

# Современный синтаксис C#
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_prefer_primary_constructors = false:suggestion
csharp_prefer_braces = true:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Явные модификаторы доступа
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:warning

# Именование: константы и статические поля — PascalCase.
# Правило идёт первым: у совпадающих правил выигрывает верхнее,
# иначе константы попали бы под правило приватных полей ниже.
dotnet_naming_rule.constants_pascal_case.severity = warning
dotnet_naming_rule.constants_pascal_case.symbols = constants_and_statics
dotnet_naming_rule.constants_pascal_case.style = pascal_case

dotnet_naming_symbols.constants_and_statics.applicable_kinds = field
dotnet_naming_symbols.constants_and_statics.applicable_accessibilities = *
dotnet_naming_symbols.constants_and_statics.required_modifiers = const,static

dotnet_naming_style.pascal_case.capitalization = pascal_case

# Именование: обычные приватные поля — с подчёркиванием
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

# Асинхронные методы должны заканчиваться на Async
dotnet_naming_rule.async_methods_end_in_async.severity = suggestion
dotnet_naming_rule.async_methods_end_in_async.symbols = async_methods
dotnet_naming_rule.async_methods_end_in_async.style = end_in_async

dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async

dotnet_naming_style.end_in_async.capitalization = pascal_case
dotnet_naming_style.end_in_async.required_suffix = Async

# Код, сгенерированный XAML-компилятором, не проверяем
[*.g.cs]
generated_code = true
